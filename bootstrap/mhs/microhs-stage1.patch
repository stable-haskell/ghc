+                            let mtgts = [ if all (`elem` map fst sub) (freeTyVars [pats !! k] `intersect` pvs)
+                                          then Just (subst sub (pats !! k))
+                                          else Nothing
+                                        | (pvs, pats, sub) <- cands ]
+                            case sequence mtgts of
+                              Nothing -> return []
+                              Just [] -> return []
+                              Just (t0 : ts)
+                                | all (eqEType t0) ts
+                                , not (famArg `eqEType` t0) -> return [(loc, famArg, t0)]
+                                | otherwise -> return []
