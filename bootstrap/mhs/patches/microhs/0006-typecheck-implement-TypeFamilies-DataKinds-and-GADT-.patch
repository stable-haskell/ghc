+  let allFeqs = if null capFeqs then feqs else capFeqs ++ feqs
+      step x = normTypeEq capEqs (expandSynFull syns allFeqs (normTypeEq capEqs x))
+      t1 = step t0
+  return $ if t1 `eqEType` t0 then t1 else step t1
