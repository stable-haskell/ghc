+
 derOrd :: Deriver
 derOrd mctx 0 lhs cs eord = do
   hdr <- mkHdr mctx lhs cs eord
@@ -581,10 +631,21 @@ derData mctx _ lhs@(utyname, vks) cs edata = do
     toConstrDef = Fcn (mkI "toConstr") $ zipWith con cs eConDefs
       where con c e = eEqn [fst $ mkPat c "x$"] e
     dataTypeOfDef = Fcn (mkI "dataTypeOf") [eEqn [eDummy] $ EVar iTyDef]
-    dataCastDef = case length vks of
-                    1 -> mk "1"
-                    2 -> mk "2"
-                    _ -> []
+    hdrCtxs :: EType -> [EConstraint]
+    hdrCtxs (EForall _ _ t) = hdrCtxs t
+    hdrCtxs (EParen t)      = hdrCtxs t
+    hdrCtxs t | Just (c, t') <- getImplies t = flatCtx c ++ hdrCtxs t'
+              | otherwise = []
+    flatCtx (ETuple cs') = concatMap flatCtx cs'
+    flatCtx (EParen c')  = flatCtx c'
+    flatCtx c'           = [c']
+    hasDataVk (IdKind v _) = any (eqEType (tApp edata (EVar v))) (hdrCtxs hdr)
+    dataCastDef | all hasDataVk vks =
+                    case length vks of
+                      1 -> mk "1"
+                      2 -> mk "2"
+                      _ -> []
+                | otherwise = []
                     where mk s = [Fcn (mkI $ "dataCast" ++ s) [eEqn [] $ EVar $ mkB $ "gcast" ++ s]]
     iTyDef = mkI "ty$"
     tyDef = Fcn iTyDef [ eEqn [] $ eAppI2 iMkDataType (str tyname) (eList eConDefs) ]
@@ -614,13 +675,14 @@ derFunctor mctx 1 lhs@(_, tyvs@(_:_)) cs efunctor = do
   let loc = getSLoc efunctor
       var = idKindIdent (last tyvs)
       eqns = map mkEqn cs
-      mkEqn c@(Constr _ _ con _ flds) =
+      mkEqn c@(Constr _ _ con _ _) =
         let (xp, xs) = mkPat c "x$"
-            ts = getFieldTys flds
+            ts = conFieldTys c
             rhs = eApps (EVar con) $ zipWith EApp (map (mkFmap eF) ts) xs
         in  eEqn [EVar iF, xp] rhs
 
       mkFmap :: Expr -> EType -> Expr    -- result has type a->a
+      mkFmap _ t | var `notElem` freeTyVars [t] = eId
       mkFmap f t =
         case getExprTuple t of
           Just ts ->
@@ -658,6 +720,7 @@ derFoldable mctx 1 lhs@(_, tyvs@(_:_)) cs efoldable = do
         in  eEqn [EVar iF, EVar iZ, xp] rhs
 
       mkFold :: Expr -> EType -> Expr   -- result has type a->b->b
+      mkFold _ t | var `notElem` freeTyVars [t] = eFlipConst
       mkFold f t =
         case getExprTuple t of
           Just ts ->
@@ -691,13 +754,14 @@ derTraversable mctx 1 lhs@(_, tyvs@(_:_)) cs eTraversable = do
   let loc = getSLoc eTraversable
       var = idKindIdent (last tyvs)
       eqns = map mkEqn cs
-      mkEqn c@(Constr _ _ con _ flds) =
+      mkEqn c@(Constr _ _ con _ _) =
         let (xp, xs) = mkPat c "x$"
-            ts = getFieldTys flds
+            ts = conFieldTys c
             rhs = foldl eAp (EApp ePure (EVar con)) $ zipWith EApp (map (mkTrav eF) ts) xs
         in  eEqn [EVar iF, xp] rhs
 
       mkTrav :: Expr -> EType -> Expr    -- result has type a->f b
+      mkTrav _ t | var `notElem` freeTyVars [t] = ePure
       mkTrav f t =
         case getExprTuple t of
           Just ts ->
