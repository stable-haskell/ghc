# ghc-pkg is not in cabal.project.stage1. `cabal buck2 --variant ghc-pkg-boot`
# appends the load of :BUCK.ghc-pkg-boot.cabal.bzl (bootstrap Cabal closure).
# The unsuffixed name stays what $(exe //utils/ghc-pkg:ghc-pkg) asks for.
# There is no :BUCK.cabal.bzl: the compiler plan must not build this package.
load(":BUCK.stage2.cabal.bzl", generated_targets_stage2 = "generated_targets")

alias(
    name = "ghc-pkg",
    actual = ":ghc-pkg-ghc-pkg-boot",
    # Same platform as the generated rule, so `buck2 build //...` does not
    # configure this alias onto the default platform.
    default_target_platform = "root//buck2/platforms:ghc-pkg-boot",
    visibility = ["PUBLIC"],
)

generated_targets_stage2()
