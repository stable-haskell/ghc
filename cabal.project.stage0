-- Cabal pin: stable-haskell/Cabal branch `feat/rpath-relativize-absolute`
-- (= stable-haskell/Cabal PR #368). Patches Link.hs to unconditionally
-- relativize absolute rpaths via `shortRelativePath` against the
-- artifact's bindir/libdir, fixing the darwin LC_RPATH leak (task #51)
-- without flipping cabal's `relocatable: True` flag — the latter also
-- emits `library-dirs: ${pkgroot}/...` which our post-stage2 bindist
-- path rewriting can't cope with. See lode/rpath-leak-investigation.md.
--
-- All stages (0/1/2/3) share this pin. The rpath patch only touches
-- host-linker codepaths (wasm-ld/JS don't use rpaths), so it's a no-op
-- for stage3's cross outputs but unifying avoids carrying two Cabals.
source-repository-package
  type: git
  location: https://github.com/stable-haskell/Cabal.git
  tag: 6a5ce8161ca76356a9ea43f2e9e09483e6f5849d
  subdir: Cabal
          Cabal-syntax
          cabal-install
          cabal-install-solver

source-repository-package
  type: git
  location: https://github.com/stable-haskell/hackage-security.git
  tag: baaad2e189a8203966f7d3f752a348f02eefd1b2
