#!/bin/sh
# Cabal runs `sh <this script>` with cwd set to the package build directory.
# Primop includes are written in that directory, which is on the cpp include
# path. Constants.hs and Config.hs go in $PWD/global-autogen.
#
# cProjectUnitId is CURRENT_PACKAGE_KEY from cabal_macros.h. cGhcInternalUnitId
# is the unit id ghc-internal exports from GHC.Internal.ThisUnitId, except
# while the compiler is built with -DBOOTSTRAPPING (stage1). That build does
# not depend on ghc-internal, and the old Setup wrote "<unavailable>".
#
# Hadrian generates the same three outputs itself and searches the build
# directory before global-autogen. If genprimopcode or deriveConstants is not
# on PATH, those two steps are skipped so Hadrian's configure still succeeds.
#
# GENPRIMOPCODE and DERIVE_CONSTANTS, when set, are absolute paths to the
# in-tree tools. The bootstrap compiler's genprimopcode is often earlier on
# PATH and rejects the current primop grammar. An empty value falls back to
# PATH.
#
# Stock Cabal passes the selected compiler as --with-compiler= and CC= on the
# command line and does not export GHC or CC. The stage1 Cabal pin does export
# them. An explicit argument wins, then the environment, then PATH.
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
ghc_cmd=${GHC:-}
cc_cmd=${CC:-}
for arg in "$@"; do
  case $arg in
    --with-compiler=*)
      v=${arg#--with-compiler=}
      [ -n "$v" ] && ghc_cmd=$v
      ;;
    CC=*)
      v=${arg#CC=}
      [ -n "$v" ] && cc_cmd=$v
      ;;
  esac
done
: "${ghc_cmd:=ghc}"
: "${cc_cmd:=cc}"

die() {
  echo "compiler configure: $*" >&2
  exit 1
}

info=$("$ghc_cmd" --info | tr -d '\n') || die "ghc --info failed"

# ghc --info is a Haskell list of pairs. show escapes the values, and
# "Haskell CPP flags" is escapeArgs output inside that string. Decode the
# Haskell string first. The old Setup then ran unescapeArgs on the flags.
hs_decode_awk='
function hs_decode(s,    i, n, c, k, out, num) {
  out = ""
  n = length(s)
  i = 1
  while (i <= n) {
    c = substr(s, i, 1)
    if (c != "\\") {
      out = out c
      i++
      continue
    }
    if (i == n) {
      out = out "\\"
      break
    }
    k = substr(s, i + 1, 1)
    if (k == "n") { out = out "\n"; i += 2 }
    else if (k == "r") { out = out "\r"; i += 2 }
    else if (k == "t") { out = out "\t"; i += 2 }
    else if (k == "a") { out = out sprintf("%c", 7); i += 2 }
    else if (k == "b") { out = out "\b"; i += 2 }
    else if (k == "f") { out = out "\f"; i += 2 }
    else if (k == "v") { out = out "\v"; i += 2 }
    else if (k == "&") { i += 2 }
    else if (k ~ /[0-9]/) {
      num = 0
      i++
      while (i <= n && substr(s, i, 1) ~ /[0-9]/) {
        num = num * 10 + (substr(s, i, 1) - 0)
        i++
      }
      out = out sprintf("%c", num)
    }
    else {
      out = out k
      i += 2
    }
  }
  return out
}
function extract_raw(info, key,    pat, pat2, i, nlen, rest, c, raw, esc) {
  pat = "(\"" key "\",\""
  pat2 = "(\"" key "\", \""
  i = index(info, pat)
  nlen = length(pat)
  if (i == 0) {
    i = index(info, pat2)
    nlen = length(pat2)
  }
  if (i == 0) return ""
  rest = substr(info, i + nlen)
  raw = ""
  esc = 0
  for (i = 1; i <= length(rest); i++) {
    c = substr(rest, i, 1)
    if (esc) {
      raw = raw "\\" c
      esc = 0
      continue
    }
    if (c == "\\") { esc = 1; continue }
    if (c == "\"") return raw
    raw = raw c
  }
  return raw
}
function is_space(c) {
  return c == " " || c == "\t" || c == "\n" || c == "\r" || c == "\f" || c == "\v"
}
function emit_rsp(s,    i, nlen, c, q, bs, cur) {
  nlen = length(s)
  q = ""
  bs = 0
  cur = ""
  for (i = 1; i <= nlen; i++) {
    c = substr(s, i, 1)
    if (bs) { cur = cur c; bs = 0; continue }
    if (c == "\\") { bs = 1; continue }
    if (q == "'\''") {
      if (c == "'\''") q = ""
      else cur = cur c
      continue
    }
    if (q == "\"") {
      if (c == "\"") q = ""
      else cur = cur c
      continue
    }
    if (is_space(c)) {
      if (cur != "") { print cur; cur = "" }
      continue
    }
    if (c == "'\''") { q = "'\''"; continue }
    if (c == "\"") { q = "\""; continue }
    cur = cur c
  }
  if (cur != "") print cur
}
'

# ("key","value") with an optional space after the comma. The result is the
# Haskell-decoded value, so platform strings are plain text.
get_info() {
  key=$1
  printf '%s\n' "$info" | awk -v key="$key" "$hs_decode_awk"'
    NR == 1 { info = $0 }
    END { printf "%s", hs_decode(extract_raw(info, key)) }
  '
}

require_info() {
  key=$1
  val=$(get_info "$key")
  if [ -z "$val" ]; then
    die "missing --info field: $key"
  fi
  printf '%s\n' "$val"
}

hs_show() {
  printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
}

autogen=$PWD/global-autogen
mkdir -p "$autogen/GHC/Settings" "$autogen/GHC/Platform"

genprimopcode_cmd=${GENPRIMOPCODE:-}
derive_constants_cmd=${DERIVE_CONSTANTS:-}
if [ -z "$genprimopcode_cmd" ]; then
  genprimopcode_cmd=$(command -v genprimopcode || true)
fi
if [ -z "$derive_constants_cmd" ]; then
  derive_constants_cmd=$(command -v deriveConstants || true)
fi
if [ -n "$genprimopcode_cmd" ] && [ -n "$derive_constants_cmd" ]; then
  target_os=$(require_info "target os")
  cpp_out=$(mktemp)
  const_tmp=$(mktemp)
  cpp_args=$(mktemp)
  trap 'rm -f "$cpp_out" "$const_tmp" "$cpp_args"' EXIT
  # Same two steps as the old Setup: Haskell-decode the --info string, then
  # unescapeArgs. Word-splitting the shown text splits paths that contain spaces.
  printf '%s\n' "$info" | awk -v key="Haskell CPP flags" "$hs_decode_awk"'
    NR == 1 { info = $0 }
    END {
      raw = extract_raw(info, key)
      if (raw == "") exit 1
      emit_rsp(hs_decode(raw))
    }
  ' > "$cpp_args" || die "missing --info field: Haskell CPP flags"
  set --
  while IFS= read -r arg || [ -n "$arg" ]; do
    [ -n "$arg" ] || continue
    set -- "$@" "$arg"
  done < "$cpp_args"
  "$cc_cmd" "$@" -P -x c -I "$root" "$root/GHC/Builtin/primops.txt.pp" > "$cpp_out"

  gen_incl() {
    "$genprimopcode_cmd" "$2" < "$cpp_out" > "$PWD/$1.tmp"
    mv "$PWD/$1.tmp" "$PWD/$1"
  }
  gen_incl primop-data-decl.hs-incl          --data-decl
  gen_incl primop-tag.hs-incl                --primop-tag
  gen_incl primop-list.hs-incl               --primop-list
  gen_incl primop-effects.hs-incl            --primop-effects
  gen_incl primop-out-of-line.hs-incl        --out-of-line
  gen_incl primop-commutable.hs-incl         --commutable
  gen_incl primop-code-size.hs-incl          --code-size
  gen_incl primop-strictness.hs-incl         --strictness
  gen_incl primop-is-work-free.hs-incl       --is-work-free
  gen_incl primop-is-cheap.hs-incl           --is-cheap
  gen_incl primop-fixity.hs-incl             --fixity
  gen_incl primop-primop-info.hs-incl        --primop-primop-info
  gen_incl primop-vector-uniques.hs-incl     --primop-vector-uniques
  gen_incl primop-vector-tys.hs-incl         --primop-vector-tys
  gen_incl primop-vector-tys-exports.hs-incl --primop-vector-tys-exports
  gen_incl primop-vector-tycons.hs-incl      --primop-vector-tycons
  gen_incl primop-docs.hs-incl               --wired-in-docs
  gen_incl primop-deprecations.hs-incl       --wired-in-deprecations
  gen_incl primop-prim-module.hs-incl        --prim-module
  gen_incl primop-wrappers-module.hs-incl    --wrappers-module

  "$derive_constants_cmd" --gen-haskell-type -o "$const_tmp" --target-os "$target_os"
  mv "$const_tmp" "$autogen/GHC/Platform/Constants.hs"
  rm -f "$cpp_out" "$cpp_args"
  cpp_out=
  cpp_args=
  trap - EXIT
else
  echo "compiler configure: genprimopcode or deriveConstants is not on PATH; skipping primops and Constants.hs" >&2
fi

build_platform=$(require_info "Host platform")
host_platform=$(require_info "Target platform")
project_name=$(require_info "Project name")
booter_version=$(require_info "Project version")

config_tmp=$autogen/GHC/Settings/Config.hs.tmp
{
  echo '{-# LANGUAGE CPP #-}'
  echo 'module GHC.Settings.Config'
  echo '  ( module GHC.Version'
  echo '  , cBuildPlatformString'
  echo '  , cHostPlatformString'
  echo '  , cProjectName'
  echo '  , cBooterVersion'
  echo '  , cStage'
  echo '  , cProjectUnitId'
  echo '  , cGhcInternalUnitId'
  echo '  ) where'
  echo
  echo 'import GHC.Prelude.Basic'
  echo
  echo 'import GHC.Version'
  echo '#ifndef BOOTSTRAPPING'
  echo 'import GHC.Internal.ThisUnitId (unitId)'
  echo '#endif'
  echo
  echo 'cBuildPlatformString :: String'
  printf 'cBuildPlatformString = %s\n' "$(hs_show "$build_platform")"
  echo
  echo 'cHostPlatformString :: String'
  printf 'cHostPlatformString = %s\n' "$(hs_show "$host_platform")"
  echo
  echo 'cProjectName          :: String'
  printf 'cProjectName          = %s\n' "$(hs_show "$project_name")"
  echo
  echo 'cBooterVersion        :: String'
  printf 'cBooterVersion        = %s\n' "$(hs_show "$booter_version")"
  echo
  echo 'cStage                :: String'
  echo 'cStage                = show (2 :: Int)'
  echo
  echo 'cProjectUnitId :: String'
  echo 'cProjectUnitId = CURRENT_PACKAGE_KEY'
  echo
  echo 'cGhcInternalUnitId :: String'
  echo '#ifdef BOOTSTRAPPING'
  echo 'cGhcInternalUnitId = "<unavailable>"'
  echo '#else'
  echo 'cGhcInternalUnitId = unitId'
  echo '#endif'
} > "$config_tmp"
mv "$config_tmp" "$autogen/GHC/Settings/Config.hs"
