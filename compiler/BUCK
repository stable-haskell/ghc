# Hand-maintained BUCK file for the `ghc` library (compiler/, build-type:
# Custom), for stage 1 (`ghc`) and stage 2 (`ghc-stage2`, see
# cabal-install's Note [Variants]).
#
# compiler/Setup.hs generates, at configure time:
#   * primop-*.hs-incl files: cpp of GHC/Builtin/primops.txt.pp piped
#     through genprimopcode, one file per flag (the table below is the
#     one in Setup.hs). The .hs files #include them, so the output
#     directory goes on the include path of the library.
#   * GHC/Platform/Constants.hs: from the deriveConstants tool.
#   * GHC/Settings/Config.hs: from `ghc --info` of the compiler that
#     builds the library and the unit ids of ghc and ghc-internal
#     (cabal-buck2/gen_settings_config.py replicates Setup.hs).
# `cabal buck2` does not run Custom setups, so this file provides them as
# genrules (BUCK.autogen.bzl), wired in through the
# :<target>-autogen-<Module> convention of the generated files. Tools
# (genprimopcode, deriveConstants) are exec deps, built once with the boot
# compiler.
load(":BUCK.cabal.bzl", "generated_targets", STAGE1_UNIT_IDS = "UNIT_IDS")
load(":BUCK.stage2.cabal.bzl", generated_targets_stage2 = "generated_targets", STAGE2_UNIT_IDS = "UNIT_IDS")
load("//libraries/ghc-internal:BUCK.stage2.cabal.bzl", GHC_INTERNAL_STAGE2_UNIT_IDS = "UNIT_IDS")
load(":BUCK.autogen.bzl", "autogen_rules")
load("@third-party-haskell//:tools.bzl", "GHC_VERSION")

# Setup.hs: `Haskell CPP flags` of the compiler (`-E -undef -traditional`
# for ghc-9.8.4) plus -P -x c, and -I<compiler root>.
genrule(
    name = "primops-txt",
    srcs = ["GHC/Builtin/primops.txt.pp"],
    out = "primops.txt",
    cmd = "gcc -E -undef -traditional -P -x c -I$SRCDIR $SRCDIR/GHC/Builtin/primops.txt.pp > $OUT",
)

PRIMOP_INCLS = {
    "primop-data-decl.hs-incl": "--data-decl",
    "primop-tag.hs-incl": "--primop-tag",
    "primop-list.hs-incl": "--primop-list",
    "primop-effects.hs-incl": "--primop-effects",
    "primop-out-of-line.hs-incl": "--out-of-line",
    "primop-commutable.hs-incl": "--commutable",
    "primop-code-size.hs-incl": "--code-size",
    "primop-strictness.hs-incl": "--strictness",
    "primop-is-work-free.hs-incl": "--is-work-free",
    "primop-is-cheap.hs-incl": "--is-cheap",
    "primop-fixity.hs-incl": "--fixity",
    "primop-primop-info.hs-incl": "--primop-primop-info",
    "primop-vector-uniques.hs-incl": "--primop-vector-uniques",
    "primop-vector-tys.hs-incl": "--primop-vector-tys",
    "primop-vector-tys-exports.hs-incl": "--primop-vector-tys-exports",
    "primop-vector-tycons.hs-incl": "--primop-vector-tycons",
    "primop-docs.hs-incl": "--wired-in-docs",
    "primop-deprecations.hs-incl": "--wired-in-deprecations",
    "primop-prim-module.hs-incl": "--prim-module",
    "primop-wrappers-module.hs-incl": "--wrappers-module",
}

# One directory with all the .hs-incl files, put on the include path of
# the library with -I$(location :primop-incls). The same for both stages:
# the primops do not depend on the compiler that builds the library.
genrule(
    name = "primop-incls",
    out = "primop-incls",
    cmd = "mkdir -p $OUT && " + " && ".join([
        "$(exe //utils/genprimopcode:genprimopcode) {flag} < $(location :primops-txt) > $OUT/{file}".format(flag = flag, file = file)
        for file, flag in PRIMOP_INCLS.items()
    ]),
)

# Stage 1: built by the boot compiler (a name on $PATH); ghc-internal is
# looked up in its package db.
autogen_rules(
    target = "ghc",
    ghc = "ghc-" + GHC_VERSION,
    ghc_pkg_or_internal = "--ghc-pkg ghc-pkg-" + GHC_VERSION,
    unit_id = STAGE1_UNIT_IDS["ghc"],
)

generated_targets(overrides = {
    "ghc": {
        "compiler_flags": ["-I$(location :primop-incls)"],
    },
    # cbits/*.c include <Rts.h>, <HsFFI.h>, <ghcversion.h> from the boot
    # compiler's RTS; the prebuilt rts target exports that include dir.
    "ghc-cxx": {
        "deps": ["@third-party-haskell//:rts"],
    },
})

# Stage 2: built by the stage-1 compiler (the //buck2-ghc wrapper, an exec
# dep); ghc-internal is the one built here.
autogen_rules(
    target = "ghc-stage2",
    ghc = "$(exe //buck2-ghc:ghc)",
    ghc_pkg_or_internal = "--ghc-internal-unit-id " + GHC_INTERNAL_STAGE2_UNIT_IDS["ghc-internal-stage2"],
    unit_id = STAGE2_UNIT_IDS["ghc-stage2"],
)

generated_targets_stage2(overrides = {
    "ghc-stage2": {
        "compiler_flags": ["-I$(location :primop-incls)"],
    },
    # cbits/*.c include <Rts.h>: the stage-2 rts headers.
    "ghc-stage2-cxx": {
        "deps": ["//rts:rts-stage2"],
    },
})
