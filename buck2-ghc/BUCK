# The two GHC installations of the buck2 build (see store.bzl):
#
# - the stage-2 toolchain: wrappers that run the stage-1 compiler built
#   here (//ghc:ghc) with a libdir of its own, like the Makefile's
#   _build/stage1/store/host/<platform>/lib. .buckconfig names them in
#   [haskell_stage2]; buck2/toolchains/BUCK selects them in the `stage2`
#   configuration (see buck2/constraints/BUCK). As exec deps of the
#   toolchain they are built with the boot compiler.
#
# - the result of stage 2: the stage-2 compiler (//ghc:ghc-stage2) with
#   every stage-2 library registered:
#
#     buck2 build //buck2-ghc:ghc-stage2 -m opt --show-output
#
#   gives a `ghc` that compiles programs.
load(":store.bzl", "ghc_store", "stage2_installation", "store_program")

ghc_store(
    name = "stage1-libdir",
    ghc = "//ghc:ghc",
    ghc_pkg = "//utils/ghc-pkg:ghc-pkg",
    tools = {"unlit": "//utils/unlit:unlit"},
)

store_program(name = "ghc", store = ":stage1-libdir", program = "ghc")

store_program(name = "ghc-pkg", store = ":stage1-libdir", program = "ghc-pkg")

# Stage 2, once generated (see Note [Variant stubs] in cabal-install's
# Distribution.Client.Buck2.Generate): the installation `stage2-libdir`
# and the programs `ghc-stage2`, `ghc-pkg-stage2`. The libraries are
# every stage-2 library (the sub-libraries of the rts come with
# //rts:rts-stage2).
stage2_installation(libraries = [
    "//compiler:ghc-stage2",
