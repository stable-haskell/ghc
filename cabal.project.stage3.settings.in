-- cabal.project.stage3.settings - generated by configure from .in template
-- Do not edit this file directly; edit cabal.project.stage3.settings.in instead.
--
-- The stage3 (wasm-cross) target ALWAYS needs shared libraries + .dyn_hi
-- files shipped in the bindist — end-user TH-heavy apps (miso, jsaddle,
-- aeson, …) hit cabal's `-dynamic-too` path for wasm32-arch packages, and
-- without the system base/ghc-internal/etc. shipping .dyn_hi files
-- alongside .hi, the user build fails with:
--
--   [GHC-47808] Failed to load dynamic interface file for X
--     …/base-4.22.0.0/X.dyn_hi: does not exist
--
-- Why the `if arch(wasm32)` guard: the stage3 cabal.project builds both
-- wasm-target packages AND host-arch build-side tools (deriveConstants,
-- happy-lib, alex). Without the conditional, `shared: True` applies to
-- those native build-side packages too, and they fail with:
--
--   [GHC-88719] Could not load module 'Prelude'.
--   Perhaps you haven't installed the "dyn" libraries for package base?
--
-- …because the bootstrap GHC's bindist has no .dyn_hi files for native
-- base. The conditional scopes the dynamic settings to wasm32 only.
--
-- We deliberately hard-code this (no per-package autoconf substitution;
-- avoid placing the literal package-list variable name here so autoconf
-- does not expand it inside the comment): the wasm bindist should never
-- ship without .dyn_hi files. DYNAMIC=0 vs DYNAMIC=1 still controls the
-- stage2 (native GHC) dynamic build, but has no effect on stage3 anymore.

package *
  if arch(wasm32)
    shared: True
    executable-dynamic: True

constraints:
  rts +dynamic
