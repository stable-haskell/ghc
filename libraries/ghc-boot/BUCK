# Hand-maintained BUCK file for ghc-boot (build-type: Custom), for stage 1
# (`ghc-boot`) and stage 2 (`ghc-boot-stage2`, see cabal-install's
# Note [Variants]).
#
# libraries/ghc-boot/Setup.hs generates GHC/Platform/Host.hs at configure
# time. `cabal buck2` does not run Custom setups, so a genrule per stage
# (BUCK.autogen.bzl) produces the module with
# cabal-buck2/gen_platform_host.py (same content, from the target platform
# of the compiler that builds the library). PackageInfo_ghc_boot is
# generated by `cabal buck2` itself.
#
# Setup.hs also adds -DGIT_COMMIT_ID=<sha>. Not replicated: GHC/Version.hs
# puts the macro inside a string literal, which GHC's traditional CPP does
# not expand, so the define has no effect in the cabal build either.
load(":BUCK.cabal.bzl", "generated_targets")
load(":BUCK.autogen.bzl", "autogen_rules", "stage2_rules")
load("@third-party-haskell//:tools.bzl", "GHC_VERSION")

# Stage 1: built by the boot compiler (a name on $PATH).
autogen_rules(target = "ghc-boot", ghc = "ghc-" + GHC_VERSION)

generated_targets()

# Stage 2 (once generated): built by the stage-1 compiler (the //buck2-ghc
# wrapper).
stage2_rules()
