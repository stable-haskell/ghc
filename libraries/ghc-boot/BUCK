# Hand-maintained BUCK file for ghc-boot (build-type: Custom).
#
# libraries/ghc-boot/Setup.hs generates GHC/Platform/Host.hs at configure
# time. `cabal buck2` does not run Custom setups, so the genrule below
# produces the module with cabal-buck2/gen_platform_host.py (same content,
# from the boot compiler's target platform). PackageInfo_ghc_boot is
# generated by `cabal buck2` itself.
#
# Setup.hs also adds -DGIT_COMMIT_ID=<sha>. Not replicated: GHC/Version.hs
# puts the macro inside a string literal, which GHC's traditional CPP does
# not expand, so the define has no effect in the cabal build either.
load(":BUCK.cabal.bzl", "generated_targets")
load("@third-party-haskell//:tools.bzl", "GHC_VERSION")

genrule(
    name = "autogen-GHC.Platform.Host",
    srcs = ["cabal-buck2/gen_platform_host.py"],
    out = "Host.hs",
    cmd = "python3 $SRCDIR/cabal-buck2/gen_platform_host.py ghc-" + GHC_VERSION + " $OUT",
)

generated_targets()
