#!/bin/sh
# Cabal runs `sh <this script>` with cwd set to the package build directory
# (dist/build) before component unit ids exist. Host.hs is written under
# $PWD/global-autogen and stays an autogen-module. Hadrian writes its own
# copy earlier on the source path; that copy is the one GHC compiles.
#
# The host triple is Cabal's --host= (pretty arch, then vendor-os). A direct
# run falls back to the compiler from --with-compiler=, HC=, or $GHC.
# Cabal 3.19 omits --host= on a native build and passes that compiler as an
# 8.3 short path. A GHCup shim invoked that way looks for "<short>.shim",
# fails with "Cannot open shim file for read.", and prints no triple. An
# empty probe then reads the long-name shim ("path = <real ghc>") and, if
# that compiler still prints nothing, the settings file beside it.
# Constructors are emitted directly so this library does not depend on
# Cabal-syntax.
#
# The commit id is $GIT_COMMIT_ID, else `git rev-parse` when this tree has a
# .git, else the GIT_COMMIT_ID file a source distribution ships at the tree
# root. Hadrian runs this script; that file is what a tarball has instead of
# .git. Same order as m4/fp_setup_project_version.m4.
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
top=$(CDPATH= cd -- "$root/../.." && pwd)

host_triple=
ghc_cmd=${GHC:-}
for arg in "$@"; do
  case $arg in
    --host=*) host_triple=${arg#--host=} ;;
    --with-compiler=*|HC=*)
      v=${arg#*=}
      [ -n "$v" ] && ghc_cmd=$v
      ;;
  esac
done
: "${ghc_cmd:=ghc}"

# shellcheck source=../../mk/resolve-ghc-shim.sh
. "$root/../../mk/resolve-ghc-shim.sh"

# Hadrian writes ("target platform string", "<triple>") into lib/settings,
# one directory above the compiler's bin/.
settings_triple() {
  bin=$1
  [ -n "$bin" ] || return 0
  settings=$(dirname "$bin")/../lib/settings
  [ -f "$settings" ] || return 0
  tr -d '\r' < "$settings" | sed -n 's/.*("target platform string", "\([^"]*\)").*/\1/p' | {
    IFS= read -r triple || true
    printf '%s' "${triple:-}"
  }
}

probe_platform() {
  "$1" --print-target-platform | tr -d '[:space:]' || true
}

if [ -z "$host_triple" ]; then
  host_triple=$(probe_platform "$ghc_cmd")
fi
if [ -z "$host_triple" ]; then
  resolved=$(shim_target "$ghc_cmd")
  if [ -n "$resolved" ]; then
    echo "ghc-boot configure: $ghc_cmd printed no host platform; using $resolved" >&2
    host_triple=$(probe_platform "$resolved")
    if [ -z "$host_triple" ]; then
      host_triple=$(settings_triple "$resolved")
    fi
  fi
fi
if [ -z "$host_triple" ]; then
  echo "ghc-boot configure: no host platform (compiler: $ghc_cmd)" >&2
  exit 1
fi

arch=${host_triple%%-*}
rest=${host_triple#*-}
osrest=${rest#*-}

case $arch in
  i386|i686)           arch_hs='ArchX86' ;;
  x86_64|amd64)       arch_hs='ArchX86_64' ;;
  ppc|powerpc)        arch_hs='ArchPPC' ;;
  ppc64|powerpc64)    arch_hs='ArchPPC_64 ELF_V1' ;;
  ppc64le|powerpc64le) arch_hs='ArchPPC_64 ELF_V2' ;;
  arm|armv5|armv6|armv7|armel|armeb) arch_hs='ArchARM ARMv7 [] SOFT' ;;
  aarch64|arm64)      arch_hs='ArchAArch64' ;;
  alpha)              arch_hs='ArchAlpha' ;;
  riscv64)            arch_hs='ArchRISCV64' ;;
  loongarch64)        arch_hs='ArchLoongArch64' ;;
  javascript)         arch_hs='ArchJavaScript' ;;
  wasm32)             arch_hs='ArchWasm32' ;;
  *)                  arch_hs='ArchUnknown' ;;
esac

# Match the old Setup.hs toOS table. Android stays OSUnknown. A libc
# suffix such as linux-gnu is still Linux. Check the android form first.
case $osrest in
  linux-android*|android*) os_hs='OSUnknown' ;;
  linux*)                  os_hs='OSLinux' ;;
  darwin*)                 os_hs='OSDarwin' ;;
  mingw32*|windows*)       os_hs='OSMinGW32' ;;
  freebsd*)                os_hs='OSFreeBSD' ;;
  openbsd*)                os_hs='OSOpenBSD' ;;
  netbsd*)                 os_hs='OSNetBSD' ;;
  dragonfly*)              os_hs='OSDragonFly' ;;
  solaris*)                os_hs='OSSolaris2' ;;
  aix*)                    os_hs='OSAIX' ;;
  gnu|gnu-*|hurd*)         os_hs='OSHurd' ;;
  ghcjs*)                  os_hs='OSGhcjs' ;;
  wasi*)                   os_hs='OSWasi' ;;
  haiku*)                  os_hs='OSHaiku' ;;
  *)                       os_hs='OSUnknown' ;;
esac

if [ -n "${GIT_COMMIT_ID:-}" ]; then
  commit=$(printf '%s' "$GIT_COMMIT_ID" | tr -d '[:space:]')
elif [ -e "$top/.git" ]; then
  commit=$(git -C "$top" rev-parse HEAD 2>/dev/null | tr -d '[:space:]' || true)
  if [ -z "$commit" ]; then
    echo "ghc-boot configure: git rev-parse failed" >&2
    exit 1
  fi
elif [ -f "$top/GIT_COMMIT_ID" ]; then
  commit=$(tr -d '[:space:]' < "$top/GIT_COMMIT_ID")
else
  echo "ghc-boot configure: no .git and no GIT_COMMIT_ID file; using zeros" >&2
  commit=0000000000000000000000000000000000000000
fi
case $commit in
  *[!A-Za-z0-9_]*)
    echo "ghc-boot configure: GIT_COMMIT_ID is not a cpp token: $commit" >&2
    exit 1
    ;;
esac

autogen=$PWD/global-autogen/GHC/Platform
mkdir -p "$autogen"
tmp=$autogen/Host.hs.tmp
cat > "$tmp" <<EOF
module GHC.Platform.Host where

import GHC.Platform.ArchOS

hostPlatformArch :: Arch
hostPlatformArch = $arch_hs

hostPlatformOS   :: OS
hostPlatformOS   = $os_hs

hostPlatformArchOS :: ArchOS
hostPlatformArchOS = ArchOS hostPlatformArch hostPlatformOS
EOF
mv "$tmp" "$autogen/Host.hs"

# Cabal reads the single *.buildinfo in the build dir after this script.
# -DGIT_COMMIT_ID=<hash> is the same unquoted flag Setup.hs passed. The
# string in GHC.Version is quoted, so cpp does not substitute it.
cat > "$PWD/ghc-boot.buildinfo" <<EOF
cpp-options: -DGIT_COMMIT_ID=$commit
EOF
