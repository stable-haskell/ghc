# Hand-maintained BUCK file for ghc-internal, stage 2 only: stage 1 uses
# the boot compiler's ghc-internal. BUCK.autogen.bzl adds the two
# modules the compiler prints.
load(":BUCK.stage2.cabal.bzl", generated_targets_stage2 = "generated_targets")
load(":BUCK.autogen.bzl", "ghc_internal_autogen_rules")

ghc_internal_autogen_rules(target = "ghc-internal-stage2", ghc = "$(exe //buck2-ghc:ghc)")

generated_targets_stage2()

# ghc-boot-th-next lists src/ in its hs-source-dirs (../ghc-internal/src).
# buck2 cannot reference files of another package by path, so every
# Haskell source under src/ is exported as a target named after its
# path, e.g. //libraries/ghc-internal:src/GHC/Internal/Lexeme.hs.
[export_file(name = f, src = f, visibility = ["PUBLIC"]) for f in glob(["src/**/*.hs"])]
