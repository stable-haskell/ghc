# Hand-maintained: ghc-boot-th-next lists this directory in its
# hs-source-dirs (../ghc-internal/src). buck2 cannot reference files of
# another package by path, so every Haskell source here is exported as a
# target named after its path, e.g.
# //libraries/ghc-internal/src:GHC/Internal/Lexeme.hs.
[export_file(name = f, src = f, visibility = ["PUBLIC"]) for f in glob(["**/*.hs"])]
