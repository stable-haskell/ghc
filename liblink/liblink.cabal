custom-setup
    setup-depends: base, Cabal >= 3.17 && < 3.18, Cabal-syntax >= 3.17 && < 3.18, directory, filepath

flag asserts
    description: Enable linker assertions.
    default: False
    manual: True

flag all-backends
    description: Include every supported linker backend.
    default: False
    manual: True

library
    build-depends: rts-fs
    extra-libraries: link
    c-sources: src/ll_version.c
    include-dirs: src include
    autogen-includes: ll_autoconf.h ll_platform.h
    install-includes:
        liblink.h
        ll_autoconf.h
        ll_platform.h
        ll_compat.h
        ll_build.h
        ll_host.h
        ll_hash.h
        ll_mutex.h
        ll_visibility.h
        ll_begin_private.h
        ll_end_private.h
        linker/M32Alloc.h
        linker/ProddableBlocks.h
        liblink/compat.h
        liblink/rts_friend.h
        liblink/symbol_extras.h
        liblink/macho.h
        liblink/coff.h
        liblink/elf.h
        linker/ElfHost.h
    cc-options: -std=c11 -fvisibility=hidden
    if flag(asserts)
        cc-options: -DLL_ASSERTS
    if flag(all-backends)
        cc-options: -DLL_ALL_BACKENDS
    if os(windows)
        cc-options: -D_WIN32_WINNT=0x06010000
        cpp-options: -D_WIN32_WINNT=0x06010000
        extra-libraries: dbghelp, psapi
        extra-libraries-static: dbghelp, psapi
    default-language: Haskell2010
