-- Stage 2 for the Buck2 build (`make buck2-stage2`, see README.md): the
-- static stage-2 project without the `build:*` constraint of
-- cabal.project.stage2.static, which the upstream cabal that has the
-- `buck2` command does not know. alex and happy are exec deps.
-- `cabal buck2 --variant stage2` does not build them. Configure finds
-- them only as `<tool>-exe` exports in third-party/haskell/BUCK.
-- mk/buck2-stage1-tools.py copies those exports from the stage1-tools cell.
import: cabal.project.stage2.common

package *
  shared: False
  executable-dynamic: False
