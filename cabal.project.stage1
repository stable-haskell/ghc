-- Configuration common to all stages
import: cabal.project.common

-- Hermetic build: resolve only from the explicitly-listed packages (+ the
-- bootstrap compiler's installed packages), never Hackage. Happy 2.1.7
-- broke genprimopcode (GHC-44432). The pinned alex and happy live in
-- cabal.project.stage1-tools, which sets the same active-repositories.
active-repositories: :none

packages:
  -- NOTE: we need rts-headers, because the _newly_ built compiler depends
  --       on these potentially _new_ headers, we must not rely on those from
  --       the rts as shipped with the bootstrap compiler. For the stage2
  --       compiler we have the `rts` available, which would have the correct
  --       headers around, now it has them through the rts -> rts-headers
  --       dependency.
  rts-headers

  -- Compiler
  ghc
  compiler

  -- Internal libraries
  libraries/ghc-boot
  libraries/ghc-boot-th-next
  libraries/ghc-platform

  -- The compiler's OsPath is filepath 1.5 / os-string 2. Bootstrap
  -- directory 1.3.8.5 and unix 2.8.6 do not export that type, and
  -- directory 1.3.10's POSIX backend imports the unix PosixString modules.
  -- semaphore-compat 1.0 does not export the protocol-version API the
  -- driver uses. file-io is a dependency of directory 1.3.10.
  --
  -- Installed process-1.6.25.0 depends on installed directory-1.3.8.5.
  -- This plan builds directory 1.3.10, so that process cannot be linked
  -- here. process-1.6.29 is rebuilt against this directory. The compiler
  -- does not import System.Process.Environment.OsString; +os-string comes
  -- from cabal.project.common and selects filepath 1.5, which is already
  -- required. libffi-clib is a dependency of rts and ghci; this plan
  -- builds neither.
  https://hackage.haskell.org/package/directory-1.3.10.0/directory-1.3.10.0.tar.gz
  https://hackage.haskell.org/package/file-io-0.1.5/file-io-0.1.5.tar.gz
  https://hackage.haskell.org/package/filepath-1.5.4.0/filepath-1.5.4.0.tar.gz
  https://hackage.haskell.org/package/os-string-2.0.8/os-string-2.0.8.tar.gz
  https://hackage.haskell.org/package/process-1.6.29.0/process-1.6.29.0.tar.gz
  https://hackage.haskell.org/package/semaphore-compat-2.0.1/semaphore-compat-2.0.1.tar.gz
  https://hackage.haskell.org/package/unix-2.8.8.0/unix-2.8.8.0.tar.gz
  https://hackage.haskell.org/package/Win32-2.14.2.1/Win32-2.14.2.1.tar.gz

-- ghc-pkg is not in this plan. cabal.project.stage1-ghc-pkg builds it
-- against the bootstrap Cabal. The Cabal pin stays in cabal.project.stage0,
-- which builds cabal-install.
--
-- alex, happy, genprimopcode, deriveConstants, ghc-toolchain, hsc2hs,
-- genapply, and unlit are not in this plan on non-Windows.
-- cabal.project.stage1-tools builds them against the bootstrap packages.
-- package ghc below sets -build-tool-depends; the Makefile passes those
-- alex and happy binaries with --with-alex and --with-happy, the same
-- way stage3 does. Win32-2.14.2.1's build-tool-depends names
-- hsc2hs:hsc2hs, and an executable on PATH does not satisfy that solver
-- goal. The same pin is added below on Windows only. Its bounds accept
-- directory 1.3.10, filepath 1.5, and process 1.6.29.

allow-newer: directory:*
           , file-io:*
           , os-string:*
           , process:*
           , semaphore-compat:*
           , unix:*
           , Win32:*

--
-- Constraints
--

constraints:
  template-haskell <= 2.22

-- Windows rebuilds time against Win32-2.14.2.1. The bootstrap time package
-- is wired to Win32-2.13.4.0 and cannot share that graph. The tarball stays
-- out of the package list on every other OS: Cabal selects this local 1.14
-- over the bootstrap time (GHC 9.8.4 ships time-1.12.2, depending only on
-- base and deepseq) whenever the tarball is visible, even without
-- `time source`. time-1.12.2 already satisfies the compiler and directory.
if os(windows)
  packages:
    https://hackage.haskell.org/package/time-1.14/time-1.14.tar.gz
  constraints: time source
  -- Win32's .hsc files. The tools plan already built this executable
  -- against the bootstrap packages; this copy is the solver dependency.
  source-repository-package
    type: git
    location: https://github.com/stable-haskell/hsc2hs.git
    tag: d07eea1260894ce5fe456f881fbc62366c9eb1b7
  allow-newer: hsc2hs:*

--
-- Package level configuration
--

package *
  shared: False
  executable-dynamic: False

if !os(windows)
  package *
    library-for-ghci: False

package ghc
  flags: +bootstrap
         +x86-ncg +aarch64-ncg
         -ppc-ncg -riscv64-ncg -loongarch64-ncg
         +host-ncg-only
         -js-backend -wasm-backend
         -llvm-backend
         -interpreter -dynamic-linker
         -hpc
         -build-tool-depends

package ghc-bin
  flags: -frontend-plugins

package ghc-boot
  flags: +bootstrap

package ghc-boot-th-next
  flags: +bootstrap
