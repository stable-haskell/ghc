[cells]
  root = .
  prelude = buck2/prelude
  toolchains = buck2/toolchains
  third-party-haskell = third-party/haskell
  # the stage-2 variant's prebuilt packages (cabal buck2 --variant stage2)
  third-party-haskell-stage2 = third-party/haskell-stage2
  none = none
  # exclude this from buck2 build //...
  example = buck2/example

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  buck = none

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default \
    target:third-party-haskell//...->prelude//platforms:default \
    target:third-party-haskell-stage2//...->prelude//platforms:default

[build]
  execution_platforms = root//buck2/platforms:exec

# Stage 2 (see README.md, "Building with Buck2"): in the stage2
# configuration the Haskell toolchain runs these wrappers around the
# stage-1 compiler built by //ghc:ghc (see buck2-ghc/BUCK).
[haskell_stage2]
  compiler = root//buck2-ghc:ghc
  packager = root//buck2-ghc:ghc-pkg
